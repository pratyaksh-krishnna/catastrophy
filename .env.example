DATABASE_URL=postgres://postgres:catastrophy@127.0.0.1:55432/catastrophy
DATABASE_URL_TEST=postgres://postgres:catastrophy@127.0.0.1:55432/catastrophy_test
REPORTER_SESSION_SECRET=

# Bedrock (Converse API). ap-south-1 reaches Claude only through the global inference profile.
# Claude models need the Anthropic use case form submitted once per account.
AWS_REGION=ap-south-1
MODEL=global.anthropic.claude-sonnet-4-6
# IAM credentials for Bedrock, S3 and SES.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# A Bedrock API key covers Bedrock alone and some organisations block it by policy.
# AWS_BEARER_TOKEN_BEDROCK=

S3_BUCKET=catastrophy-media
SES_FROM=alerts@example.invalid
ESCALATION_INBOX=escalations@example.invalid
MCD_ESCALATION_EMAIL=mcd@example.invalid
DDA_ESCALATION_EMAIL=dda@example.invalid
DDMA_ESCALATION_EMAIL=ddma@example.invalid

# Area Signals ingestion. Committed fixtures replay by default and need no key.
# Set both of these to scrape live Delhi news and civic sources instead.
INGEST_SOURCE=fixtures
FIRECRAWL_API_KEY=

# Set INNGEST_DEV=1 to use the local Inngest dev server; leave the keys blank locally.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
